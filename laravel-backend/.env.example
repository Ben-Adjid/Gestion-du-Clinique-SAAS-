APP_NAME="Clinique+"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.td
# Adresse du site Next.js : liens des e-mails et retour après paiement Flutterwave.
FRONTEND_URL=https://app.example.td

APP_TIMEZONE=Africa/Ndjamena
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL 8 (base visible dans MySQL Workbench). En local, DB_CONNECTION=sqlite fonctionne aussi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinique_plus
DB_USERNAME=clinique_plus
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Durée de vie des jetons d'API en minutes (vide = sans expiration).
SANCTUM_EXPIRATION=720

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Les webhooks Flutterwave sont traités en file d'attente : lancer « php artisan queue:work ».
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.td
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.td"
MAIL_FROM_NAME="${APP_NAME}"

# --- Clinique+ ---------------------------------------------------------------
APPOINTMENT_SLOT_MINUTES=30

# Rôles obligés d'activer la double authentification (laisser la valeur par défaut en production).
TOTP_REQUIRED_ROLES=SUPER_ADMIN,ADMIN_CLINIC,DOCTOR,CASHIER

# Abonnements : délai de paiement d'une facture, puis tolérance avant suspension.
SAAS_PAYMENT_TERMS_DAYS=7
SAAS_SUSPEND_AFTER_DAYS=7
# true : bloquer la clinique dès qu'une facture est en retard (sans délai de grâce).
CLINIC_BLOCK_PAST_DUE=false

# Coordonnées affichées aux cliniques pour le paiement manuel.
SAAS_ORANGE_MONEY_NUMBER="+235 66 00 00 00"
SAAS_MOOV_MONEY_NUMBER="+235 99 00 00 00"
SAAS_AIRTEL_MONEY_NUMBER="+235 60 00 00 00"
SAAS_BANK_ACCOUNT="TD00 0000 0000 0000 0000 0000 000"

# --- Flutterwave v3 ----------------------------------------------------------
# Tableau de bord Flutterwave > Settings > API Keys (clés FLWPUBK_TEST / FLWSECK_TEST en test).
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Settings > Webhooks : même valeur que le champ « Secret hash ». URL du webhook :
# https://api.example.td/api/webhooks/flutterwave
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PAYMENT_OPTIONS=card,mobilemoneyfranco,banktransfer
FLUTTERWAVE_TIMEOUT=20
FLUTTERWAVE_LOGO_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
